<Window x:Name="Tetris_from_DeepSeek" x:Class="Tetris.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Tetris.Wpf.Views"
        xmlns:conv="clr-namespace:Tetris.Wpf.Converters"
        Title="Tetris from DeepSeek" Height="770" Width="480"
        Background="#12161f"
        KeyDown="OnKeyDown"
        Focusable="True"
        Loaded="OnLoaded" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:IntEqualsToVisibilityConverter x:Key="FourToVisible"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <views:GameBoardControl x:Name="BoardControl"
                            Grid.Column="0"
                            Width="300" Height="600" />

        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">
            <TextBlock Text="TETRIS" Foreground="#7cf" FontSize="28" FontWeight="Bold" Margin="0,0,0,16"/>

            <TextBlock Text="Score" Foreground="#889" FontSize="12"/>
            <TextBlock Text="{Binding Score}" Foreground="White" FontSize="22" Margin="0,0,0,12"/>

            <TextBlock Text="Level" Foreground="#889" FontSize="12"/>
            <TextBlock Text="{Binding Level}" Foreground="White" FontSize="22" Margin="0,0,0,12"/>

            <TextBlock Text="Speed (ms/tick)" Foreground="#889" FontSize="12"/>
            <TextBlock Text="{Binding TickMilliseconds}" Foreground="White" FontSize="16" Margin="0,0,0,12"/>

            <TextBlock Text="Lines" Foreground="#889" FontSize="12"/>
            <TextBlock Text="{Binding Lines}" Foreground="White" FontSize="22" Margin="0,0,0,12"/>

            <!-- Превью следующей фигуры -->
            <TextBlock Text="Next" Foreground="#889" FontSize="12" Margin="0,8,0,4"/>
            <views:NextPieceControl x:Name="NextControl" Width="120" Height="90"/>

            <TextBlock Text="{Binding Status}" Foreground="#f88" FontSize="16" Margin="0,16,0,0"/>

            <TextBlock Text="Controls" Foreground="#889" FontSize="12" Margin="0,16,0,4"/>
            <TextBlock Foreground="#ccd" FontSize="12" TextWrapping="Wrap">
            ← → — move<LineBreak/>
            ↑ — rotate<LineBreak/>
            ↓ — soft drop<LineBreak/>
            Space — hard drop<LineBreak/>
            P — pause<LineBreak/>
            R — restart<LineBreak/>
            G — toggle ghost<LineBreak/>
            Esc - exit
            </TextBlock>

            <TextBlock Text="TETRIS!" Foreground="#ffd54a" FontSize="20" FontWeight="Bold"
                HorizontalAlignment="Center" Margin="0,8,0,0"
                Visibility="{Binding LastCleared, Converter={StaticResource FourToVisible}}"/>

        </StackPanel>
    </Grid>
</Window>